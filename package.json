{
  "name": "learn-redis-pubsub",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone sandbox for learning Redis Pub/Sub, mirroring flexipill-core conventions.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "ts-node src/main.ts",
    "start:local": "PORT=3001 INSTANCE_NAME=LOCAL NODE_ENV=local ts-node src/main.ts",
    "start:prod": "PORT=3002 INSTANCE_NAME=PROD NODE_ENV=prod ts-node src/main.ts",
    "start:misconfigured": "PORT=3003 INSTANCE_NAME=PROD_MISCONFIGURED NODE_ENV=local ts-node src/main.ts",
    "redis:cli": "docker exec -it learn-redis redis-cli",
    "redis:spy": "docker exec -it learn-redis redis-cli PSUBSCRIBE \"*\"",
    "redis:channels": "docker exec learn-redis redis-cli PUBSUB CHANNELS"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.3",
    "@nestjs/core": "^10.3.3",
    "@nestjs/platform-express": "^10.3.3",
    "ioredis": "^5.3.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
